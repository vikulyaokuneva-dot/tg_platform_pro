# -*- coding: utf-8 -*-
"""case_pipeline.postgen вЂ” CASE -> РїРѕСЃС‚ РґР»СЏ РєР°РЅР°Р»Р° В«AI РђРІС‚РѕРјР°С‚РёР·Р°С†РёСЏ | Р‘РёР·РЅРµСЃВ».

РџРѕР·РёС†РёРѕРЅРёСЂРѕРІР°РЅРёРµ: РџР РћР‘Р›Р•РњРђ в†’ Р Р•РЁР•РќРР• в†’ РљРђРљ РђР’РўРћРњРђРўРР—РР РћР’РђР›Р в†’ Р Р•Р—РЈР›Р¬РўРђРў в†’
Р­Р¤Р¤Р•РљРў в†’ РџР РРњР•РќРРњРћРЎРўР¬ в†’ CTA. РџСЂР°РєС‚РёС‡РµСЃРєРёР№ С‚РѕРЅ, Р±РµР· С…Р°Р№РїР°.

Р”РІР° СЂРµР¶РёРјР°:
  1. template вЂ” РґРµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅС‹Р№ RU-РєР°СЂРєР°СЃ, С„Р°РєС‚С‹ вЂ” С†РёС‚Р°С‚С‹ РёР· CASE (РІСЃРµРіРґР°
     РґРѕСЃС‚СѓРїРµРЅ, Р±РµР· AI);
  2. ai_polish (РµСЃР»Рё GigaChat РґРѕСЃС‚СѓРїРµРЅ) вЂ” RU-РїРµСЂРµСЂР°Р±РѕС‚РєР° CASE; СЂРµР·СѓР»СЊС‚Р°С‚
     РІР°Р»РёРґРёСЂСѓРµС‚СЃСЏ: РќР РѕРґРЅРѕ РЅРѕРІРѕРµ С‡РёСЃР»Рѕ, РєРѕРјРїР°РЅРёСЏ СЃРѕС…СЂР°РЅРµРЅР°, С…Р°Р№Рї-СЃС‚РѕРї-С„СЂР°Р·С‹.
     РџСЂРѕРІР°Р» РІР°Р»РёРґР°С†РёРё => РѕС‚РєР°С‚ Рє template.

validate_post() РѕР±СЏР·Р°С‚РµР»РµРЅ РїРµСЂРµРґ РїСѓР±Р»РёРєР°С†РёРµР№ РІ РѕР±РѕРёС… СЂРµР¶РёРјР°С….
"""
import json
import logging
import re

from . import ai as ai_mod
from . import hashtags, langguard, textclean
from .utils import digits_of, extract_numbers, norm_num_text, ws_norm

log = logging.getLogger("case_pipeline.postgen")

HYPE_RX = re.compile(r"(СЂРµРІРѕР»СЋС†РёРѕРЅ|РјРµРЅСЏРµС‚ РІСЃС‘|РІСЃС‘ РёР·РјРµРЅРёС‚|Р±СѓРґСѓС‰РµРµ СѓР¶Рµ Р·РґРµСЃСЊ|"
                     r"РЅРµРІРµСЂРѕСЏС‚РЅ|РїСЂРѕСЂС‹РІ|СѓРЅРёРєР°Р»СЊРЅ|РёРЅРЅРѕРІР°С†РёРѕРЅРЅ)", re.I)
HASHTAGS = "#AI #Р°РІС‚РѕРјР°С‚РёР·Р°С†РёСЏ #РєРµР№СЃР±РёР·РЅРµСЃР°"  # legacy-РєРѕРЅСЃС‚Р°РЅС‚Р° (Р·Р°РјРµРЅРµРЅР° СЃР»РѕРІР°СЂС‘Рј hashtags)

CTA_SALES = ("рџ’ј Р•СЃР»Рё Сѓ РІР°СЃ СЃРѕС‚СЂСѓРґРЅРёРєРё РІСЂСѓС‡РЅСѓСЋ РїРµСЂРµРЅРѕСЃСЏС‚ Р·Р°СЏРІРєРё, РґРѕРєСѓРјРµРЅС‚С‹ РёР»Рё "
             "РѕР±СЂР°С‰РµРЅРёСЏ РјРµР¶РґСѓ СЃРµСЂРІРёСЃР°РјРё вЂ” С‚Р°РєРѕР№ РїСЂРѕС†РµСЃСЃ РѕР±С‹С‡РЅРѕ РїРѕРґРґР°С‘С‚СЃСЏ "
             "Р°РІС‚РѕРјР°С‚РёР·Р°С†РёРё: Р·Р°СЏРІРєРё в†’ AI-РєР»Р°СЃСЃРёС„РёРєР°С†РёСЏ в†’ CRM/Telegram в†’ РѕС‚РІРµС‚ "
             "РєР»РёРµРЅС‚Сѓ Р·Р° СЃРµРєСѓРЅРґС‹.")
CTA_SUPPORT = ("рџ’ј РџРѕРґРѕР±РЅС‹Рµ СЃС…РµРјС‹ СЂР°Р±РѕС‚Р°СЋС‚ Рё РІ РјР°Р»РѕРј Р±РёР·РЅРµСЃРµ: РѕР±СЂР°С‰РµРЅРёСЏ в†’ AI-"
               "РјР°СЂС€СЂСѓС‚РёР·Р°С†РёСЏ в†’ Р±Р°Р·Р° Р·РЅР°РЅРёР№ в†’ РѕС‚РІРµС‚ РёР»Рё СЌСЃРєР°Р»Р°С†РёСЏ. Р СѓС‡РЅРѕР№ "
               "РєРѕР»Р»-С†РµРЅС‚СЂ/РїРѕРґРґРµСЂР¶РєР° вЂ” РїРµСЂРІРѕРµ, С‡С‚Рѕ СЃС‚РѕРёС‚ Р°РІС‚РѕРјР°С‚РёР·РёСЂРѕРІР°С‚СЊ.")
CTA_DOCS = ("рџ’ј Р”РѕРєСѓРјРµРЅС‚С‹, СЃРѕРіР»Р°СЃРѕРІР°РЅРёСЏ, РѕС‚С‡С‘С‚РЅРѕСЃС‚СЊ вЂ” С‚Рѕ Р¶Рµ РїРѕР»Рµ Р±РѕСЏ: С€Р°Р±Р»РѕРЅС‹ в†’ "
            "AI-РїСЂРѕРІРµСЂРєР° в†’ РјР°СЂС€СЂСѓС‚РёР·Р°С†РёСЏ в†’ РєРѕРЅС‚СЂРѕР»СЊ. РћР±С‹С‡РЅРѕ РѕРєСѓРїР°РµС‚СЃСЏ Р·Р° "
            "РїРµСЂРІС‹Рµ РЅРµРґРµР»Рё.")
CTA_GENERIC = ("рџ’ј РџРѕРґРѕР±РЅСѓСЋ СЃС…РµРјСѓ РјРѕР¶РЅРѕ СЃРѕР±СЂР°С‚СЊ Рё РїРѕРґ РЅРµР±РѕР»СЊС€РѕР№ Р±РёР·РЅРµСЃ: РґР°РЅРЅС‹Рµ в†’ "
               "AI-РѕР±СЂР°Р±РѕС‚РєР° в†’ РЅСѓР¶РЅР°СЏ СЃРёСЃС‚РµРјР° в†’ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРёР№ РѕС‚РєР»РёРє. "
               "РЎРёР»Р° вЂ” РЅРµ РІ СЂР°Р·РјРµСЂРµ РєРѕРјРїР°РЅРёРё, Р° РІ РїСЂР°РІРёР»СЊРЅРѕ РІС‹Р±СЂР°РЅРЅРѕРј РїСЂРѕС†РµСЃСЃРµ.")


def pick_cta(case):
    blob = ws_norm(" ".join([case.get("problem", ""), case.get("implementation", "")] +
                             list(case.get("results") or [])))
    if re.search(r"lead|sales|Р·Р°СЏРІРє|crm|pipeline|СЃРґРµР»Рє|РІС‹СЂСѓС‡Рє|revenue|quota|"
                 r"СЂРµРєР»Р°Рј|РјР°СЂРєРµС‚РёРЅРі|СЃС‚Р°РІРє|РєРѕРЅРІРµСЂСЃРё|С‚СЂР°С„РёРє|click|retarget|РєР°РјРїР°РЅРё|СЃРєРёРґРє", blob):
        return CTA_SALES
    if re.search(r"document|РґРѕРєСѓРјРµРЅС‚|report|РѕС‚С‡С‘С‚|invoice|СЃС‡РµС‚|СЃС‡С‘С‚|finance|С„РёРЅР°РЅСЃ|compliance|budget|Р±СЋРґР¶РµС‚|СЃРѕРіР»Р°СЃРѕРІ", blob):
        return CTA_DOCS
    if re.search(r"support|РїРѕРґРґРµСЂР¶Рє|helpdesk|ticket|РѕР±СЂР°С‰РµРЅРё|call|service", blob):
        return CTA_SUPPORT
    return CTA_GENERIC


def _short(s, n=220):
    s = re.sub(r"\s+", " ", (s or "")).strip()
    return s if len(s) <= n else s[:n].rsplit(" ", 1)[0] + "вЂ¦"


PREP_RX = re.compile(r"(?:\s|^)(?:Рє|РЅР°|РґРѕ|РІ|Р·Р°|РїРѕ|СЃ|Сѓ|РѕС‚|РґР»СЏ|Р±РµР·|РїСЂРё)\s*$")


def _num_members(text):
    """(С‚РѕРєРµРЅС‹ С‡РёСЃРµР», С†РёС„СЂРѕРІС‹Рµ СЏРґСЂР°) вЂ” РµРґРёРЅР°СЏ РјРµСЂР° В«С‡РёСЃР»Рѕ СѓРїРѕРјРёРЅР°РµС‚СЃСЏ РІ С‚РµРєСЃС‚РµВ»
    РґР»СЏ С„РёР»СЊС‚СЂР° Р¦РёС„СЂС‹ Рё РґР»СЏ editorial_check."""
    nums = extract_numbers(norm_num_text(ws_norm(text)))
    cores = {digits_of(n) for n in nums if digits_of(n)}
    return nums, cores


def _num_used(val, nums, cores):
    v = ws_norm(re.sub(r"\s+", "", val or ""))
    return bool(v) and (v in nums or (digits_of(v) in cores if digits_of(v) else False))


def _metric_parts(metric):
    """(Р·РЅР°С‡РµРЅРёРµ, РєРѕСЂРѕС‚РєРёР№ РєРѕРЅС‚РµРєСЃС‚ РёР· evidence-С†РёС‚Р°С‚С‹ РёСЃС‚РѕС‡РЅРёРєР°). РЎР»РѕРІР° вЂ”
    С‚РѕР»СЊРєРѕ РёР· РёСЃС‚РѕС‡РЅРёРєР°, РІС‹РґСѓРјС‹РІР°РЅРёСЏ РЅРµС‚."""
    val = textclean.clean((metric.get("value") or "").strip())
    quote = textclean.clean((metric.get("evidence") or {}).get("quote") or "")
    ctx = ""
    idx = quote.find(val)
    if idx > 0:
        words = re.findall(r"[A-Za-zРђ-РЇР°-СЏРЃС‘][A-Za-zРђ-РЇР°-СЏРЃС‘'-]{1,}", quote[:idx])
        ctx = PREP_RX.sub("", " ".join(words[-4:])).strip()
    return val, ctx


# ===========================================================================
#  РЎРњР«РЎР›РћР’РћР™ Р—РђР“РћР›РћР’РћРљ: РљРўРћ + Р§РўРћ РџР РћРР—РћРЁР›Рћ + Р—Рђ РЎР§РЃРўРћ Р§Р•Р“Рћ
#
#  Р—Р°РіРѕР»РѕРІРѕРє РќР• СЃРѕР±РёСЂР°РµС‚СЃСЏ РёР· СЃРїРёСЃРєР° РјРµС‚СЂРёРє Рё РЅРµ СЃРєР»РµРёРІР°РµС‚СЃСЏ РёР· СЃС‹СЂС‹С… СЃР»РѕРІ
#  РїРµСЂРµРґ С†РёС„СЂРѕР№. РљР°Р¶РґР°СЏ evidence-С†РёС‚Р°С‚Р° СЂР°Р·Р±РёСЂР°РµС‚СЃСЏ РЅР° РєРѕРЅСЃС‚СЂСѓРєС†РёРё РґРµР»РѕРІРѕРіРѕ
#  СЂРµР·СѓР»СЊС‚Р°С‚Р°:
#    РїР°СЂР° "22,9% в†’ 36% РґРѕР»СЏ РєР»РёРµРЅС‚РѕРІвЂ¦"   -> В«РґРѕР»СЏ вЂ¦ РІС‹СЂРѕСЃР»Р° СЃ 22,9% РґРѕ 36%В»
#    РјРЅРѕР¶РёС‚РµР»СЊ "Г—4,3 РІС‹СЂСѓС‡РєР° РѕС‚ вЂ¦"       -> В«РІС‹СЂСѓС‡РєР° вЂ¦ РІС‹СЂРѕСЃР»Р° РІ 4,3 СЂР°Р·Р°В»
#    РіР»Р°РіРѕР» В«X РІС‹СЂРѕСЃР»Р° РЅР° N%В»             -> СЃСѓР±СЉРµРєС‚+РіР»Р°РіРѕР»+С†РёС„СЂР° РґРѕСЃР»РѕРІРЅРѕ
#    РґР°С‚РµР»СЊРЅР°СЏ "+N% Рє РІС‹СЂСѓС‡РєРµ СЃ РєР»РёРєР°"    -> РґРѕСЃР»РѕРІРЅРѕ (СѓР¶Рµ РіСЂР°РјРјР°С‚РёС‡РЅРѕ)
#    РїРѕСЂРѕРі "Р”Р Р  РЅРµ РІС‹С€Рµ 16%"              -> РґРѕСЃР»РѕРІРЅРѕ
#    В«78% вЂ” РєРѕРЅРІРµСЂСЃРёСЏ РІ вЂ¦В»                -> СЂРµРІРµСЂСЃ СЃ С‚РёСЂРµ
#  Р“Р»Р°РІРЅС‹Р№ СЂРµР·СѓР»СЊС‚Р°С‚ вЂ” РїРѕ СЂР°РЅРіСѓ СЃРµРјСЊРё (РІС‹СЂСѓС‡РєР°/РїСЂРѕРґР°Р¶Рё > РєРѕРЅРІРµСЂСЃРёСЏ/РїРѕРІС‚РѕСЂРЅС‹Рµ
#  > СЌРєРѕРЅРѕРјРёРєР° > РѕРїРµСЂР°С†РёРѕРЅРєР° > РїСЂРѕС‡РµРµ), Р±РѕРЅСѓСЃ Р·Р° С†РёС„СЂСѓ РІ Р·Р°РіРѕР»РѕРІРєРµ СЃС‚Р°С‚СЊРё,
#  Р·Р°С‚РµРј РІРµР»РёС‡РёРЅР°. РњРµС…Р°РЅРёР·Рј (В«Р·Р° СЃС‡С‘С‚ вЂ¦В») вЂ” С‚РѕР»СЊРєРѕ РґРѕСЃР»РѕРІРЅРѕ РёР· evidence РёР»Рё
#  РёР· РєРѕРЅС‚СЂРѕР»СЊРЅРѕРіРѕ Р»РµРєСЃРёРєРѕРЅР°, С‡СЊРё РїРѕРІРµСЂС…РЅРѕСЃС‚Рё РЅР°Р№РґРµРЅС‹ РІ evidence; AI/ML РЅРµ
#  РїРѕРІС‹С€Р°СЋС‚СЃСЏ: С„РѕСЂРјСѓР»РёСЂРѕРІРєР° СЂРѕРІРЅРѕ С‚Р°, С‡С‚Рѕ РµСЃС‚СЊ РІ РёСЃС‚РѕС‡РЅРёРєРµ.
# ===========================================================================

_NAME = r"[\w\-']"
_WORD2 = r"[\w'\-]{2,}"
_PAIR_RX = re.compile(
    r"(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.?)?\s*(?:в†’|->)\s*(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.?)?\s+"
    r"([^\W\d_]" + _NAME + r"*(?:\s+[^\W\d_]" + _NAME + r"*){1,6})", re.U)
_MULT_RX = re.compile(
    r"[Г—]\s*(\d[\d.,]*)\s+([^\W\d_]" + _NAME + r"*(?:\s+[^\W\d_]" + _NAME + r"*){0,6})", re.U)
_GREW_RX = re.compile(
    r"\b(РІС‹СЂРѕСЃР»\w*|СѓРІРµР»РёС‡РёР»\w*|СѓРІРµР»РёС‡РµР»\w*|СѓРІРµР»РёС‡РµРЅ\w*|РїРѕРІС‹СЃРёР»\w*|СЃРЅРёР·РёР»\w*|СЃРѕРєСЂР°С‚РёР»\w*"
    r"|СѓРјРµРЅСЊС€РёР»\w*|СѓРїР°Р»\w*|СѓРїР°Р»Рѕ|СѓРїР°Р»Рё|РїРѕРґРЅСЏР»\w*|СѓР»СѓС‡С€РёР»\w*|СѓСЃРєРѕСЂРёР»\w*|СѓСЃРєРѕСЂРёР»[Р°Рё]?|РІС‹СЂРѕСЃС‚\w*)\b"
    r"\s*(?:\b(РЅР°|РґРѕ|РІ|Р·Р°)\b\s*)?[-+\u2212]?(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.|РјРёРЅСѓС‚\w*|С‡Р°СЃРѕРІ|С‡Р°СЃР°\b|РґРЅРµР№|РґРЅСЏ\b|в‚Ѕ|СЂР°Р·\w*)", re.U)
_GREW_RX = re.compile(_GREW_RX.pattern, re.I)
_DELTA_RX = re.compile(
    r"([+\u2212])\s*(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.)\s+Рє\s+((?:" + r"[\w'\-]+" + r"\s){1,5}" + r"[\w'\-]+" + r")", re.U)
_HEADVAL_RX = re.compile(
    r"([+\u2212])\s*(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.)\s+((?:" + r"[\w'\-]+" + r"\s){1,5}" + r"[\w'\-]+" + r")", re.U)
_THRESH_RX = re.compile(
    r"\b(Р”Р Р |ROMI|ROI|CPA|CPC)\b[^\d%!]{0,28}?\b(РЅРµ РІС‹С€Рµ|РЅРµ Р±РѕР»РµРµ|РЅРµ РґРѕР»Р¶РµРЅ РїСЂРµРІС‹С€Р°С‚СЊ|РјРµРЅРµРµ|РЅРёР¶Рµ)\s*(\d[\d.,]*)\s*(%)", re.U)
_REVERSE_RX = re.compile(
    r"\b(\d[\d.,]*)\s*(%)\s*[вЂ”вЂ“\-]{1,2}\s*\b(РєРѕРЅРІРµСЂСЃРёСЏ|РґРѕР»СЏ|РІС‹СЂСѓС‡РєР°|РїСЂРѕРґР°Р¶Рё|СЂР°СЃС…РѕРґС‹|СЂРѕСЃС‚|РјР°СЂР¶РёРЅР°Р»СЊРЅ\w+|open rate|CTOR|CTR)\b"
    r"([^+в€’Г—\d%!]{0,50})", re.U)
# В«СѓРїР°Р»/РІС‹СЂРѕСЃР»Р° вЂ¦ СЃ A РґРѕ BВ»: РїРѕРґР»РµР¶Р°С‰РµРµ РїРµСЂРµРґ РіР»Р°РіРѕР»РѕРј РёР»Рё РѕР±СЉРµРєС‚ РїРѕСЃР»Рµ РЅРµРіРѕ
_SLIDE_RX = re.compile(
    r"((?:" + _WORD2 + r"\s){1,4})(РІС‹СЂРѕСЃР»\w*|СѓРІРµР»РёС‡РёР»\w*|РїРѕРІС‹СЃРёР»\w*|РїРѕРґРЅСЏР»\w*|СѓРїР°Р»\w*"
    r"|СѓРїР°Р»Р°|СѓРїР°Р»Рё|СЃРЅРёР·РёР»\w*|СЃРѕРєСЂР°С‚РёР»\w*|СѓРјРµРЅСЊС€РёР»\w*)\s+СЃ\s+(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.?)?\s*"
    r"РґРѕ\s+(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.)", re.I)
_SLIDE2_RX = re.compile(
    r"\b(РІС‹СЂРѕСЃР»\w*|СѓРІРµР»РёС‡РёР»\w*|РїРѕРІС‹СЃРёР»\w*|РїРѕРґРЅСЏР»\w*|СѓРїР°Р»\w*|СѓРїР°Р»Р°|СѓРїР°Р»Рё|СЃРЅРёР·РёР»\w*"
    r"|СЃРѕРєСЂР°С‚РёР»\w*|СѓРјРµРЅСЊС€РёР»\w*)\s+((?:" + _WORD2 + r"\s){1,3})СЃ\s+(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.?)?\s*"
    r"РґРѕ\s+(\d[\d.,]*)\s*(%|Рї\.\s?Рї\.)", re.I)
_REDUCEN_RX = re.compile(
    r"(\d[\d.,]*)\s*%\s+(?:reductions?|cuts?|decreases?|drops?|savings)\s+(?:in|of|on)\s+"
    r"((?:[\w'\-]+\s){1,4}[\w'\-]+)", re.I)
